# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so your keys never reach GitHub.
# On Vercel, add the same variables under Project > Settings > Environment Variables.

# ---- Supabase (accounts and orders): Project Settings > API ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret key (sb_secret_...). Server only. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Paid app files: GitHub Releases in a private repo (free, 2 GB per file) ----
# Repo as owner/name, for example iamaffanyasir/visualter-apps
GITHUB_RELEASES_REPO=
GITHUB_RELEASES_TAG=apps
# Fine grained token limited to that one repo, with Contents: Read and write. Secret.
GITHUB_RELEASES_TOKEN=

# Only used if the GitHub values above are empty: private Supabase Storage bucket.
SUPABASE_APPS_BUCKET=apps

# Public address of the site, used in sign up confirmation emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Razorpay: Dashboard > Settings > API Keys (use Test mode keys first) ----
# Key ID is public (it is shown in the checkout); set both names to the same value.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
RAZORPAY_KEY_ID=
# Secret. Server only.
RAZORPAY_KEY_SECRET=
# Same secret you type in Dashboard > Settings > Webhooks for
# https://visualter.com/api/payments/razorpay/webhook (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=

# Emails allowed into /admin, comma separated. Sign up on the site with one of these.
ADMIN_EMAILS=
